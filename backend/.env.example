DATABASE_URL="postgresql://user:password@localhost:5432/leaves_dev"
JWT_SECRET="replace-with-a-real-secret"
PORT=4000

# In staging/production, set this to the deployed frontend's URL (e.g.
# https://leaves-web-xxxx.onrender.com). Leave as * for local dev.
CORS_ORIGIN="*"

# --- Object storage (visit photos/videos) ---
# Leave S3_BUCKET unset to use the local-disk fallback (fine for local dev,
# NOT durable — do not rely on it in staging/production; see storage.ts).
#
# Works with either AWS S3 or Cloudflare R2 (R2 speaks the same S3 API):
#   AWS S3:       leave S3_ENDPOINT unset, set S3_REGION to your bucket's region
#   Cloudflare R2: set S3_ENDPOINT to https://<account-id>.r2.cloudflarestorage.com,
#                  S3_REGION can stay "auto"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public URL prefix used to build the URL returned to the frontend — e.g. a
# CDN domain in front of the bucket, or the bucket's own public URL.
S3_PUBLIC_URL_BASE=""

# --- Ticket notifications ---
# Leave SMTP_HOST unset to fall back to console-logging new tickets (fine for
# local dev; not a real notification). Any standard SMTP provider works
# (e.g. SendGrid, Postmark, AWS SES, Gmail SMTP for quick testing).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_FROM_EMAIL="no-reply@leaves.test"
# Who should receive new/emergency ticket notifications — e.g. the supervisor
# or a shared team inbox. Required for email notifications to actually send.
NOTIFY_TICKETS_TO_EMAIL=""
